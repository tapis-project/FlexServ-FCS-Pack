{
  "additionalProperties": false,
  "description": "The compiler accepts only FCS-owned evidence references and typed user choices.",
  "properties": {
    "intent": {
      "$ref": "#/$defs/DeploymentIntent"
    },
    "preparation_ref": {
      "type": "string"
    },
    "recipe_ref": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_ref": {
      "type": "string"
    }
  },
  "required": [
    "snapshot_ref",
    "preparation_ref",
    "intent"
  ],
  "type": "object",
  "$defs": {
    "DeploymentIntent": {
      "additionalProperties": false,
      "description": "User choices do not contain executable paths, trusted snapshots or credential bytes.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "backend_interface": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "device_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "engine": {
          "default": "vllm",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "model_id": {
          "default": "",
          "type": "string"
        },
        "pipeline_parallel_size": {
          "default": 1,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "port": {
          "default": null,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeImport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service_interface": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tensor_parallel_size": {
          "default": 1,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PlanInput": {
      "additionalProperties": false,
      "description": "The compiler accepts only FCS-owned evidence references and typed user choices.",
      "properties": {
        "intent": {
          "$ref": "#/$defs/DeploymentIntent"
        },
        "preparation_ref": {
          "type": "string"
        },
        "recipe_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_ref": {
          "type": "string"
        }
      },
      "required": [
        "snapshot_ref",
        "preparation_ref",
        "intent"
      ],
      "type": "object"
    },
    "RecipeImport": {
      "additionalProperties": false,
      "description": "An immutable imported recipe with reference hardware separated from real hardware.",
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "digest": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "model_id": {
          "type": "string"
        },
        "reference_gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "revision",
        "digest",
        "engine",
        "model_id",
        "args",
        "environment"
      ],
      "type": "object"
    }
  }
}
