{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": { "type": "string" },
    "role": { "type": "string", "enum": ["head", "worker"] },
    "master_addr": { "type": "string" },
    "master_port": { "type": "integer", "default": 29500 },
    "tensor_parallel_size": { "type": "integer", "minimum": 1, "default": 1 },
    "pipeline_parallel_size": { "type": "integer", "minimum": 1, "default": 1 }
  },
  "required": ["model", "role", "master_addr", "master_port", "tensor_parallel_size", "pipeline_parallel_size"]
}
